[Unit]
Description=Pen plotter web UI (Tailscale)
Documentation=https://github.com/VytenisO/picasso-at-home
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/robotlab/picasso-at-home
# Optional: PLOTTER_WEB_PASSWORD, PLOTTER_WEB_HOST, PLOTTER_WEB_PORT,
# PLOTTER_WEB_SIM=1 (simulator: no hardware is ever touched).
# Stopping the service stops a running job first (pen up, motors off); allow time for it.
TimeoutStopSec=90
# Note: if the user was added to dialout after login, re-login/reboot is needed
# for the user manager to pick up the new group.
# "-": ignore if the file does not exist (then the server generates a password).
EnvironmentFile=-%h/.config/plotter-web.env
ExecStart=/usr/bin/python3 /home/robotlab/picasso-at-home/tools/plot_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
