  {
   "id": "s001",
   "section": "sentences",
   "text": "The quick brown fox jumps\nover the lazy dog.",
   "lines": 2
  },
  {
   "id": "s002",
   "section": "sentences",
   "text": "Pack my box with five\ndozen liquor jugs.",
   "lines": 2
  },
  {
   "id": "s003",
   "section": "sentences",
   "text": "How vexingly quick daft\nzebras jump!",
   "lines": 2
  },
  {
   "id": "s004",
   "section": "sentences",
   "text": "Sphinx of black quartz,\njudge my vow.",
   "lines": 2
  },
  {
   "id": "s005",
   "section": "sentences",
   "text": "A journey of a thousand\nmiles begins with a step.",
   "lines": 2
  },
  {
   "id": "s006",
   "section": "sentences",
   "text": "Vår sære Zulu fra badeøya\nspilte jo whist og quickstep.",
   "lines": 2
  },
  {
   "id": "s007",
   "section": "sentences",
   "text": "Blåbærsyltetøy er godt\npå brødskive.",
   "lines": 2
  },
  {
   "id": "s008",
   "section": "sentences",
   "text": "Jeg skriver for hånd\nmed en tegnemaskin.",
   "lines": 2
  },
  {
   "id": "s009",
   "section": "sentences",
   "text": "Meet at 14:30, room 7,\nbuilding 12 (second floor).",
   "lines": 2
  },
  {
   "id": "s010",
   "section": "sentences",
   "text": "Call 555-0123 or write:\nhello@example.com",
   "lines": 2
  },
  {
   "id": "s011",
   "section": "sentences",
   "text": "\"Yes,\" she said, \"but why?\"\nNo one knew; it rained all day.",
   "lines": 2
  },
  {
   "id": "s012",
   "section": "sentences",
   "text": "Price: 249,50 kr (25 % off)\n& free shipping!",
   "lines": 2
